# server (Express) — set these in Railway (and .env locally). NEVER commit real values.
# Postgres connection (Railway injects this via a reference variable).
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Set to true only if connecting over the public proxy URL (SSL required).
DATABASE_SSL=false
# Clerk — server-side session verification (Phase 1).
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY_HERE
CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY_HERE
# Resend — scheduled city report (Phase 5).
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
RESEND_FROM=L.I.V.E. SJ Reports <reports@wimmops.com>
# Cron report endpoint guard (Phase 5).
CRON_SECRET=change-me-long-random-string
CITY_REPORT_RECIPIENTS=person1@example.com,person2@example.com
